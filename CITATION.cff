  - type: book
    title: "The ns-3 Network Simulator"
    authors:
      - family-names: "Riley"
        given-names: "George F."
      - family-names: "Henderson"
        given-names: "Thomas R."
    collection-title: "Modeling and Tools for Network Simulation"
